<Project Sdk="Microsoft.Build.NoTargets">
  <Import Project="../NuGet.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Redistribution of ANESE for use with .NES</Description>
    <Authors>Klaus Loeffelmann (NuGet), $(Authors)</Authors>
    <PackageProjectUrl>https://github.com/VICE-Team/svn-mirror/blob/main/README.md</PackageProjectUrl>
    <PackageTags>$(PackageTags) Emulator</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageVersion>3.9</PackageVersion>
    <WindowsUrl>https://github.com/VICE-Team/svn-mirror/releases/download/3.9.0/GTK3VICE-3.9-win64.zip</WindowsUrl>
    <GithubLicenseUrl>https://vice-emu.sourceforge.io/COPYING</GithubLicenseUrl>
    <NoWarn>$(NoWarn);NU5119;NU5128</NoWarn>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <BeforePack>
      _AddPackageFiles;
      $(BeforePack);
    </BeforePack>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <None Update="..\..\assets\LICENSE">
      <Pack>True</Pack>
    </None>
    <None Update="..\..\assets\LICENSE">
      <PackagePath>\</PackagePath>
    </None>
    <None Update="@(None)" Pack="true" PackagePath="" />
    <_Downloads Include="$(IntermediateOutputPath)GTK3VICE-$(PackageVersion)-win64.zip" />
  </ItemGroup>
  <Target Name="_Download" BeforeTargets="Build" Inputs="$(MSBuildThisFile)" Outputs="@(_Downloads)">
    <Delete Files="@(_Downloads)" />
    <DownloadFile SourceUrl="$(WindowsUrl)" DestinationFolder="$(IntermediateOutputPath)" />
    <ItemGroup>
      <FileWrites Include="@(_Downloads)" />
    </ItemGroup>
  </Target>
  <Target Name="_Unzip" AfterTargets="_Download" Inputs="$(MSBuildThisFile)" Outputs="$(IntermediateOutputPath)_Unzip.stamp">
    <RemoveDir Directories="$(IntermediateOutputPath)win" />
    <Unzip SourceFiles="$(IntermediateOutputPath)GTK3VICE-$(PackageVersion)-win64.zip" DestinationFolder="$(IntermediateOutputPath)win\" />
    <Touch AlwaysCreate="true" Files="$(IntermediateOutputPath)_Unzip.stamp" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)_Unzip.stamp" />
    </ItemGroup>
  </Target>
  <Target Name="_AddPackageFiles">
    <ItemGroup>
      <_PackageFiles Include="$(IntermediateOutputPath)win/GTK3VICE-$(PackageVersion)-win64/COPYING" PackagePath="" />
      <_PackageFiles Include="$(IntermediateOutputPath)win/GTK3VICE-$(PackageVersion)-win64/C64/*" PackagePath="tools/win64/C64" />
      <_PackageFiles Include="$(IntermediateOutputPath)win//GTK3VICE-$(PackageVersion)-win64/bin/*.dll" PackagePath="tools/win64/bin" />
    </ItemGroup>
  </Target>
</Project>
